From 14473b139bb3b1dfd1312ccb991dff617e4975e8 Mon Sep 17 00:00:00 2001
From: Orgad Shaneh <orgad.shaneh@audiocodes.com>
Date: Tue, 13 Oct 2026 11:30:16 +0300
Subject: [PATCH 4/4] keep a=label in publish answer

monologue_publish() never copied the offered label into the media,
so sdp_create() omitted a=label from the publish answer and from
subscribe requests for that publisher. Add the missing
media_update_label() call.
---
 daemon/call.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/daemon/call.c b/daemon/call.c
index 0f9d991c..834de5d5 100644
--- a/daemon/call.c
+++ b/daemon/call.c
@@ -4343,6 +4343,7 @@ int monologue_publish(struct call_monologue *ml, sdp_streams_q *streams, sdp_ng_
 		media_update_type(media, sp);
 		media_update_protocol(media, sp);
 		media_update_media_id(media, sp);
+		media_update_label(media, flags, &sp->label);
 		media_loop_protect(sp, media);
 		media_update_flags(media, sp);
 		media_update_crypto(media, sp, flags);
-- 
